# API base URL. Empty uses the page origin; Vite proxies to localhost:8080 in development.
VITE_API_BASE_URL=
# Optional reverse-proxy prefix (e.g. /api). Empty calls /v1 and /v2 directly.
# Production proxies must strip this prefix before forwarding to the backend.
VITE_API_PREFIX=

# CDN URL for static assets
VITE_CDN_URL=https://cdn.jsdmirror.com

# Node install script URL shown to admins (runs as root on the node and receives the node secret).
# Point it at your own audited fork of ppanel-node; empty falls back to the upstream script.
VITE_NODE_INSTALL_SCRIPT_URL=

# Enable tutorial document feature (true/false)
VITE_TUTORIAL_DOCUMENT=true

# Default login credentials (for development only)
VITE_USER_EMAIL=
VITE_USER_PASSWORD=
